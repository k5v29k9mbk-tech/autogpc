# Nexus — environment variables. Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored (see *.local in .gitignore). Never commit real keys.
#
# Find Supabase values in the dashboard: Project Settings -> API.

# ---------------------------------------------------------------------------
# CLIENT-SIDE (safe in the browser bundle).
# Vite only exposes variables prefixed with VITE_ to the app, and it INLINES
# them into the shipped JS. Only put public values here.
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The PUBLISHABLE key (new-style, starts with sb_publishable_). Public client
# key, designed to be shipped to browsers.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — NOT USED THIS SPRINT. DO NOT ADD A `VITE_` PREFIX.
#
# The Supabase SECRET key (sb_secret_) bypasses Row Level Security and must
# NEVER reach the browser, a URL, or a log. Nexus has no server that uses it
# yet — it belongs to the future GovCloud backend (admin API, RLS-bypassing
# jobs). Leave it unset in any client deployment.
# ---------------------------------------------------------------------------

# SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# CLOUD EXTRACTION (Sprint 2, optional) — AWS Textract via /api/extract.
# ---------------------------------------------------------------------------

# CLIENT toggle. "true" routes image receipts (and scanned PDFs) to the cloud
# OCR path first, falling back to in-browser Tesseract if the call fails.
# Leave "false" (or unset) to ship the standalone client-only build.
VITE_CLOUD_EXTRACTION=false

# SERVER-ONLY — used by the /api/extract serverless function. NEVER prefix with
# VITE_ (that would inline the secret into the browser bundle).
#
# IMPORTANT: do NOT name these AWS_REGION / AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY on Vercel — those are RESERVED by AWS Lambda (which runs
# Vercel functions) and get overridden by the runtime's own role. Use the
# TEXTRACT_* names below; the function reads them explicitly.
#
# Use a dedicated IAM principal scoped to ONLY `textract:AnalyzeExpense`
# (least privilege). Region must support AnalyzeExpense (e.g. eu-west-1,
# eu-central-1, us-east-1). For real GPC PII, use an AWS GovCloud region under
# an ATO; synthetic/scrubbed data only in commercial regions.
TEXTRACT_REGION=eu-west-1
TEXTRACT_ACCESS_KEY_ID=
TEXTRACT_SECRET_ACCESS_KEY=
